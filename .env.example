# Copy to ".env" (gitignored) for local dev / running the scraper locally.
# On GitHub, set the same values as repo secrets instead (see README).

# ── Frontend (safe to be public; shipped in the browser bundle) ──
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-public-key...

# ── Scraper only (SECRET — never prefix these with VITE_, never commit) ──
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your-service_role-key...
TAURI_COOKIE=tSessionId=PASTE_YOUR_LOGGED_IN_SESSION_COOKIE_HERE
DEFAULT_REALM=[EN] Evermoon
